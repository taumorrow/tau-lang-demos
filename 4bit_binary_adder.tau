# Title: Simple 4-bit Binary Adder
# Description: Adds two 4-bit binary numbers and produces a 5-bit result (to handle
# overflow). Each number is a tuple of bit functions; Tau normalizes each result
# bit to a concrete 0 / 1.

# First number (A) - 4 bits
a4(x) := 1  # LSB (least significant bit)
a3(x) := 1
a2(x) := 0
a1(x) := 0  # MSB (most significant bit)

# Second number (B) - 4 bits
b4(x) := 0  # LSB (least significant bit)
b3(x) := 1
b2(x) := 0
b1(x) := 0  # MSB (most significant bit)

# Half adder - two bits, no carry-in:  sum = XOR, carry = AND
halfAdderSum(a,b) := a ^ b
halfAdderCarry(a,b) := a & b

# Full adder - two bits plus a carry-in:  sum = triple XOR, carry = majority
fullAdderSum(a,b,c) := a ^ b ^ c
fullAdderCarry(a,b,c) := (a & b) | (a & c) | (b & c)

# === BINARY ADDITION (ripple carry) ===
# Each sum bit is a full adder whose carry-in is the carry-out of all the bits
# below it. The carry chain is written out inline so that 'n' reduces each bit to
# a plain 0/1 (a reference to a separately named carry function would be left
# unevaluated).
bit0(x) := halfAdderSum(a4(x), b4(x))
bit1(x) := fullAdderSum(a3(x), b3(x), halfAdderCarry(a4(x), b4(x)))
bit2(x) := fullAdderSum(a2(x), b2(x), fullAdderCarry(a3(x), b3(x), halfAdderCarry(a4(x), b4(x))))
bit3(x) := fullAdderSum(a1(x), b1(x), fullAdderCarry(a2(x), b2(x), fullAdderCarry(a3(x), b3(x), halfAdderCarry(a4(x), b4(x)))))
bit4(x) := fullAdderCarry(a1(x), b1(x), fullAdderCarry(a2(x), b2(x), fullAdderCarry(a3(x), b3(x), halfAdderCarry(a4(x), b4(x)))))

# Show the result bit by bit (LSB -> MSB).
# Example here: A = 0011 = 3, B = 0010 = 2, so A + B = 5 = 00101.
n bit0(x)   # expect 1
n bit1(x)   # expect 0
n bit2(x)   # expect 1
n bit3(x)   # expect 0
n bit4(x)   # expect 0  (overflow bit)
