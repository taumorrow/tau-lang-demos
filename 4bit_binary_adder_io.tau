# Title: 4-bit Binary Adder (File I/O)
# Description: Adds two 4-bit binary numbers A + B and produces a 5-bit result
# (to handle overflow). Inputs come from io/*.in, results are written to io/*.out.
# The whole adder is a single 'run always' spec: the carry streams o6..o9 are used
# directly by the next full adder, so there are no intermediate files.

# === INPUT FILES: two 4-bit numbers (Bit0 = LSB) ===
# Number A
i1 : sbf := in file("io/const0.in")  # A Bit 0 (LSB)
i2 : sbf := in file("io/const1.in")  # A Bit 1
i3 : sbf := in file("io/const1.in")  # A Bit 2
i4 : sbf := in file("io/const0.in")  # A Bit 3 (MSB)
# Number B
i5 : sbf := in file("io/const1.in")  # B Bit 0 (LSB)
i6 : sbf := in file("io/const1.in")  # B Bit 1
i7 : sbf := in file("io/const0.in")  # B Bit 2
i8 : sbf := in file("io/const0.in")  # B Bit 3 (MSB)

# === OUTPUT FILES ===
# Sum S - 5 bits (o5 = overflow)
o1 : sbf := out file("io/o1.out")  # S Bit 0 (LSB)
o2 : sbf := out file("io/o2.out")  # S Bit 1
o3 : sbf := out file("io/o3.out")  # S Bit 2
o4 : sbf := out file("io/o4.out")  # S Bit 3
o5 : sbf := out file("io/o5.out")  # S Bit 4 (overflow/MSB)
# Intermediate carries (used directly inside the spec)
o6 : sbf := out file("io/o6.out")  # carry out of bit 0
o7 : sbf := out file("io/o7.out")  # carry out of bit 1
o8 : sbf := out file("io/o8.out")  # carry out of bit 2
o9 : sbf := out file("io/o9.out")  # carry out of bit 3 (= overflow)

# === ADDER FUNCTION DEFINITIONS ===
# (Functions used inside a run spec need a type: ': sbf'.)
halfAdderSum(a,b)     : sbf := a ^ b                    # sum bit  = a XOR b
halfAdderCarry(a,b)   : sbf := a & b                    # carry    = a AND b
fullAdderSum(a,b,c)   : sbf := a ^ b ^ c                # sum with carry-in
fullAdderCarry(a,b,c) : sbf := (a & b) | (a & c) | (b & c)  # carry (majority)

# === BINARY ADDITION - one ripple-carry chain, ONE spec ===
# Each carry oN is used immediately by the next full adder (o6 -> bit1,
# o7 -> bit2, o8 -> bit3).
run always (
  # Bit 0: half adder (no carry-in)
  (o1[t] = halfAdderSum(i1[t], i5[t])) &&
  (o6[t] = halfAdderCarry(i1[t], i5[t])) &&
  # Bit 1: full adder with carry o6
  (o2[t] = fullAdderSum(i2[t], i6[t], o6[t])) &&
  (o7[t] = fullAdderCarry(i2[t], i6[t], o6[t])) &&
  # Bit 2: full adder with carry o7
  (o3[t] = fullAdderSum(i3[t], i7[t], o7[t])) &&
  (o8[t] = fullAdderCarry(i3[t], i7[t], o7[t])) &&
  # Bit 3: full adder with carry o8
  (o4[t] = fullAdderSum(i4[t], i8[t], o8[t])) &&
  (o9[t] = fullAdderCarry(i4[t], i8[t], o8[t])) &&
  # Bit 4: overflow = final carry
  (o5[t] = o9[t])
)

# Example (io/): A=6 -> i1..i4 = 0,1,1,0 ;  B=3 -> i5..i8 = 1,1,0,0.
# Expected sum S = o5,o4,o3,o2,o1 = 0,1,0,0,1 = 01001 = 9.
