# Title: 4-bit Binary Subtractor
# Description: Subtracts a 4-bit number B from a 4-bit number A via two's complement
# and produces a 5-bit result (bit 4 is the sign bit). Each number is a tuple of bit
# functions; Tau normalizes each result bit to a concrete 0 / 1.

# First number (A) - 4 bits (minuend)
a4(x) := 1  # LSB
a3(x) := 0
a2(x) := 1
a1(x) := 0  # MSB

# Second number (B) - 4 bits (subtrahend)
b4(x) := 1  # LSB
b3(x) := 0
b2(x) := 0
b1(x) := 0  # MSB

# Half adder / full adder helpers (these get expanded by 'n')
halfAdderSum(a,b) := a ^ b
halfAdderCarry(a,b) := a & b
fullAdderSum(a,b,c) := a ^ b ^ c
fullAdderCarry(a,b,c) := (a & b) | (a & c) | (b & c)

# === STEP 1: TWO'S COMPLEMENT OF B  (invert every bit, then add 1) ===
# Adding 1 is a ripple carry starting at the LSB (bit 4). The carry chain is inlined
# so each bit reduces to a concrete 0/1.
twoComp4(x) := halfAdderSum(b4(x)', 1)
twoComp3(x) := fullAdderSum(b3(x)', 0, halfAdderCarry(b4(x)', 1))
twoComp2(x) := fullAdderSum(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1)))
twoComp1(x) := fullAdderSum(b1(x)', 0, fullAdderCarry(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1))))
# For B = 0001 = 1, the two's complement is 1111 (which represents -1).
n twoComp4(x)   # expect 1
n twoComp3(x)   # expect 1
n twoComp2(x)   # expect 1
n twoComp1(x)   # expect 1

# === STEP 2: ADD A TO THE TWO'S COMPLEMENT OF B ===
# A - B = A + (two's complement of B), again a ripple-carry addition. Each result
# bit inlines both the two's-complement chain and the addition carry chain, so 'n'
# prints a concrete digit. Bit 4 is the sign bit (inverted final carry).
bit0(x) := halfAdderSum(a4(x), halfAdderSum(b4(x)', 1))
bit1(x) := fullAdderSum(a3(x), fullAdderSum(b3(x)', 0, halfAdderCarry(b4(x)', 1)), halfAdderCarry(a4(x), halfAdderSum(b4(x)', 1)))
bit2(x) := fullAdderSum(a2(x), fullAdderSum(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1))), fullAdderCarry(a3(x), fullAdderSum(b3(x)', 0, halfAdderCarry(b4(x)', 1)), halfAdderCarry(a4(x), halfAdderSum(b4(x)', 1))))
bit3(x) := fullAdderSum(a1(x), fullAdderSum(b1(x)', 0, fullAdderCarry(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1)))), fullAdderCarry(a2(x), fullAdderSum(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1))), fullAdderCarry(a3(x), fullAdderSum(b3(x)', 0, halfAdderCarry(b4(x)', 1)), halfAdderCarry(a4(x), halfAdderSum(b4(x)', 1)))))
bit4(x) := (fullAdderCarry(a1(x), fullAdderSum(b1(x)', 0, fullAdderCarry(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1)))), fullAdderCarry(a2(x), fullAdderSum(b2(x)', 0, fullAdderCarry(b3(x)', 0, halfAdderCarry(b4(x)', 1))), fullAdderCarry(a3(x), fullAdderSum(b3(x)', 0, halfAdderCarry(b4(x)', 1)), halfAdderCarry(a4(x), halfAdderSum(b4(x)', 1))))))'

# Example: A = 0101 = 5, B = 0001 = 1, so A - B = 4 = 00100.
n bit0(x)   # expect 0
n bit1(x)   # expect 0
n bit2(x)   # expect 1
n bit3(x)   # expect 0
n bit4(x)   # expect 0  (sign bit: 0 = non-negative)
