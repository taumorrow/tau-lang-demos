# ============================================================================
# TABLES TUTORIAL (ADVANCED) - growing tables, tables as values
# Rows as facts, SELECT as meet, and an append-only ledger over time
# ============================================================================
#
# The ADVANCED companion to adt_tables_basic.tau. Fixed tables are
# assumed; this file is about tables that GROW - and about the deepest
# move: a whole table as ONE value of the tau algebra, queried by algebra.
#
# Run with (minimal cost):
#   TAU_BA_COMPONENT_FACTORING=1 tau -q < adt_tables_advanced.tau
# Needs a build with ADTs (2026-08-28+); verified against 0.7.0-alpha,
# build 0ac2756f.
#
# READING THE OUTPUT: "%N: ..." lines answer the n queries - the N
# restarts whenever a statement carries type declarations, so match the
# answers by ORDER, not by number (annotations say "Answer:"). The ledger
# run at the end prints tuple wire lines ob[k] := { tab: "...", sel: "..." }
# whose expected content is annotated at the run - the formulas themselves
# are the results there, so this file's machine contract covers the %N
# lines. (The wire lines below the run are the last lines of the file on
# purpose: a tuple console stream reads until end-of-file.)
# ============================================================================

# EXPECTED-RESULTS: T F T T T T T F

set charvar off
set maxsplits 1

# ============================================================================
# PART 1: SCHEMA GUARANTEES - business rules as theorems
# ============================================================================
#
# (The theorem here is the one adt_tables_basic.tau part 3 proves;
# what is NEW is the second query - the unsat CONTROL that basic omits.)
# Over a fixed schema, a rule is not checked row by row - it is proved
# for EVERY table at once:

type Row = {id: bv[8], qty: bv[8]}. type Tab = {r1: Row, r2: Row, r3: Row}. n all t:Tab ((t.r1.qty = { #x0A }:bv[8] && t.r2.qty = { #x14 }:bv[8] && t.r3.qty = { #x1E }:bv[8]) -> t.r1.qty + t.r2.qty + t.r3.qty = { #x3C }:bv[8])
# Answer: T - every such table totals 60.

type Row = {id: bv[8], qty: bv[8]}. type Tab = {r1: Row, r2: Row, r3: Row}. n ex t:Tab (t.r1.qty = { #x0A }:bv[8] && t.r2.qty = { #x14 }:bv[8] && t.r3.qty = { #x1E }:bv[8] && t.r1.qty + t.r2.qty + t.r3.qty != { #x3C }:bv[8])
# Answer: F - no counterexample exists: the rule is a theorem, not a habit.

# ============================================================================
# PART 2: A TABLE AS ONE TAU VALUE - rows as facts, SELECT as meet
# ============================================================================
#
# The deep move: encode a ROW as a fact (a specification fixing the
# column streams), and a TABLE as the DISJUNCTION of its rows - one value
# of the tau algebra. The relational operations become algebra - stated
# precisely, because two different tests hide here:
#
#   OVERLAP        (x & table) != 0     x and the table share models
#   MEMBERSHIP     (x & table') = 0     x entails the table (x <= table)
#   SELECT by key  (partial & table)    the meet IS the matching row set
#
# For a FULLY specified row the two tests agree (all columns fixed, so
# sharing a model means being a row). For a PARTIAL row they split: the
# key {oid=2} OVERLAPS the table but is not CONTAINED in it - which is
# exactly what makes it a SELECT and not a row. Both shown below.
#
# The two-row table used throughout:
#   { oid=1, oqty=10 } | { oid=2, oqty=20 }

n ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] }) != 0
# Answer: T - the table is a live, non-zero value.

n (({ oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] }) & ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] })) != 0
# Answer: T - row (2,20) IS in the table: its meet with the table is not 0.

n (({ oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] }) & ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] })') = 0
# Answer: T - and row (2,20) is a MEMBER in the strict sense too: its meet
#         with the table's complement is empty (row <= table).

n (({ oid[t]:bv[8] = { #x03 }:bv[8] && oqty[t]:bv[8] = { #x1E }:bv[8] }) & ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] })) = 0
# Answer: T - row (3,30) is NOT in the table: even the overlap is empty.
#         Negative answers are proofs too.

n (({ oid[t]:bv[8] = { #x02 }:bv[8] }) & ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] })) != 0
# Answer: T - SELECT WHERE id=2: the PARTIAL row (only the key) overlaps the
#         table; the meet itself IS the matching row set.

n (({ oid[t]:bv[8] = { #x02 }:bv[8] }) & ({ oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8] } | { oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8] })') = 0
# Answer: F - but the key is NOT a member: it does not entail the table.
#         Overlap found it; membership rightly refuses it. That is the
#         whole difference between a query and a row.

# ============================================================================
# PART 3: THE LEDGER - an append-only table over time
# ============================================================================
#
# Tau's constitutional runs accumulate law by MEET (&): each adopted rule
# CONSTRAINS. A growing table is the DUAL: accumulate rows by JOIN (|) -
# each appended row EXTENDS. Same kernel, opposite lattice direction.
#
# One structured input per step ({row, probe}), one structured output
# ({tab, sel}), all in equation form:
#   tab[t] = tab[t-1] | row[t]      append (0 initialises: the empty table)
#   sel[t] = probe[t] & tab[t-1]    SELECT against yesterday's table
#
# Expected wire output:
#   ob[0]: tab F (empty table); sel F is a free witness here - nothing
#          constrains sel[0], the engine just picks one
#   ob[1]: tab = row(1,10)          sel F (the probe was F)
#   ob[2]: tab = both rows (printed order may differ)
#                                   sel = row(1,10): the id=1 probe runs
#                                   against tab[t-1] = row(1,10), finds it,
#                                   and the meet IS the matching row
#   ob[3]: tab unchanged - byte-identical to ob[2]'s (appending the F row
#          is a no-op: tab | F = tab)  sel F (id=3 is in no row)
#
# On the wire a tau member is bare spec text with a period; the F row
# below ("o9[t]=0 && o9[t]=1.") is the empty contribution - appending F
# changes nothing, probing with F selects nothing.

type Zeile = {row: tau, probe: tau}. type Bestand = {tab: tau, sel: tau}. iz:Zeile := in console. ob:Bestand := out console. run (ob[0].tab = 0) && (ob[t].tab = ob[t-1].tab | iz[t].row) && (ob[t].sel = iz[t].probe & ob[t-1].tab)
{ row: "oid[t]:bv[8] = { #x01 }:bv[8] && oqty[t]:bv[8] = { #x0A }:bv[8].", probe: "o9[t]=0 && o9[t]=1." }
{ row: "oid[t]:bv[8] = { #x02 }:bv[8] && oqty[t]:bv[8] = { #x14 }:bv[8].", probe: "oid[t]:bv[8] = { #x01 }:bv[8]." }
{ row: "o9[t]=0 && o9[t]=1.", probe: "oid[t]:bv[8] = { #x03 }:bv[8]." }
