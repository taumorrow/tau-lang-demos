# ============================================================================
# BINARY ENCODING TUTORIAL - Numbers & Arithmetic in a Boolean-Only World
# ============================================================================
# Description: How to represent and manipulate 4-bit numbers using nothing but
# Boolean functions in Tau. No bitvectors, no streams - just AND / OR / XOR / NOT
# combined into adders, comparators, increment and decrement.
#
# Each number is a tuple of bit-FUNCTIONS; each operation is a composition of
# Boolean functions. Tau normalizes them to 0 / 1. Show any result with
# 'n <function>(x)'.

# ============================================================================
# PART 1 - THE BUILDING BLOCKS (general logic, no numbers yet)
# ============================================================================
# A half adder adds two bits: sum = XOR, carry = AND.
halfAdderSum(a,b)   := a ^ b        # sum bit  = a XOR b
halfAdderCarry(a,b) := a & b        # carry    = a AND b

# A full adder adds two bits PLUS an incoming carry c.
fullAdderSum(a,b,c)   := a ^ b ^ c                  # sum   = triple XOR
fullAdderCarry(a,b,c) := (a & b) | (a & c) | (b & c) # carry = majority (>=2 of 3)

# You can inspect the logic SYMBOLICALLY before plugging in numbers:
n halfAdderSum(a,b)       # expected: (a^b)
n fullAdderCarry(a,b,c)   # expected: the majority function of a,b,c

# ============================================================================
# PART 2 - TWO CONCRETE 4-BIT NUMBERS
# ============================================================================
# Bit convention: Bit0 = LSB (least significant), Bit3 = MSB (most significant).
# A = 6 = 0110  ->  aBit0=0, aBit1=1, aBit2=1, aBit3=0
aBit0(x) := 0
aBit1(x) := 1
aBit2(x) := 1
aBit3(x) := 0
# B = 3 = 0011  ->  bBit0=1, bBit1=1, bBit2=0, bBit3=0
bBit0(x) := 1
bBit1(x) := 1
bBit2(x) := 0
bBit3(x) := 0
# (To experiment, just change the 0/1 values above - everything below recomputes.)

# ============================================================================
# PART 3 - ADDITION:  A + B   (expect 6 + 3 = 9 = 01001)
# ============================================================================
# Ripple-carry: bit 0 with a half adder, then each bit with a full adder whose
# carry-in is the carry-out of the bits below. The carry chain is inlined so that
# 'n' reduces each bit to a plain 0/1.
addBit0(x) := halfAdderSum(aBit0(x), bBit0(x))
addBit1(x) := fullAdderSum(aBit1(x), bBit1(x), halfAdderCarry(aBit0(x), bBit0(x)))
addBit2(x) := fullAdderSum(aBit2(x), bBit2(x), fullAdderCarry(aBit1(x), bBit1(x), halfAdderCarry(aBit0(x), bBit0(x))))
addBit3(x) := fullAdderSum(aBit3(x), bBit3(x), fullAdderCarry(aBit2(x), bBit2(x), fullAdderCarry(aBit1(x), bBit1(x), halfAdderCarry(aBit0(x), bBit0(x)))))
addBit4(x) := fullAdderCarry(aBit3(x), bBit3(x), fullAdderCarry(aBit2(x), bBit2(x), fullAdderCarry(aBit1(x), bBit1(x), halfAdderCarry(aBit0(x), bBit0(x)))))   # overflow bit

# Result bit by bit (LSB -> MSB). Assembled: addBit4..addBit0 = 01001 = 9.
n addBit0(x)   # expect 1
n addBit1(x)   # expect 0
n addBit2(x)   # expect 0
n addBit3(x)   # expect 1
n addBit4(x)   # expect 0

# ============================================================================
# PART 4 - COMPARISON:  A == B,  A > B,  A < B   (expect: 6>3, so greater=1)
# ============================================================================
# Two bits are equal if both are 1 OR both are 0 (that is XNOR).
eqBit0(x) := (aBit0(x) & bBit0(x)) | (aBit0(x)' & bBit0(x)')
eqBit1(x) := (aBit1(x) & bBit1(x)) | (aBit1(x)' & bBit1(x)')
eqBit2(x) := (aBit2(x) & bBit2(x)) | (aBit2(x)' & bBit2(x)')
eqBit3(x) := (aBit3(x) & bBit3(x)) | (aBit3(x)' & bBit3(x)')
# A == B exactly when ALL four bits are equal.
equals(x) := eqBit0(x) & eqBit1(x) & eqBit2(x) & eqBit3(x)

# A > B: compare from the MSB down. A is greater as soon as, at the first position
# (from the top) where they differ, A has a 1 and B has a 0.
gtBit3(x) := aBit3(x) & bBit3(x)'
gtBit2(x) := eqBit3(x) & aBit2(x) & bBit2(x)'
gtBit1(x) := eqBit3(x) & eqBit2(x) & aBit1(x) & bBit1(x)'
gtBit0(x) := eqBit3(x) & eqBit2(x) & eqBit1(x) & aBit0(x) & bBit0(x)'
greater(x) := gtBit3(x) | gtBit2(x) | gtBit1(x) | gtBit0(x)

# A < B is everything else: neither equal nor greater.
less(x) := equals(x)' & greater(x)'

n equals(x)    # expect 0  (6 != 3)
n greater(x)   # expect 1  (6 > 3)
n less(x)      # expect 0

# ============================================================================
# PART 5 - INCREMENT:  A + 1   (expect 6 + 1 = 7 = 00111)
# ============================================================================
# Trick: add the constant 1 = 0001 with the same adder logic.
constBit0(x) := 1
constBit1(x) := 0
constBit2(x) := 0
constBit3(x) := 0
incBit0(x) := halfAdderSum(aBit0(x), constBit0(x))
incBit1(x) := fullAdderSum(aBit1(x), constBit1(x), halfAdderCarry(aBit0(x), constBit0(x)))
incBit2(x) := fullAdderSum(aBit2(x), constBit2(x), fullAdderCarry(aBit1(x), constBit1(x), halfAdderCarry(aBit0(x), constBit0(x))))
incBit3(x) := fullAdderSum(aBit3(x), constBit3(x), fullAdderCarry(aBit2(x), constBit2(x), fullAdderCarry(aBit1(x), constBit1(x), halfAdderCarry(aBit0(x), constBit0(x)))))
incBit4(x) := fullAdderCarry(aBit3(x), constBit3(x), fullAdderCarry(aBit2(x), constBit2(x), fullAdderCarry(aBit1(x), constBit1(x), halfAdderCarry(aBit0(x), constBit0(x)))))

n incBit0(x)   # expect 1
n incBit1(x)   # expect 1
n incBit2(x)   # expect 1
n incBit3(x)   # expect 0
n incBit4(x)   # expect 0

# ============================================================================
# PART 6 - DECREMENT:  A - 1   (expect 6 - 1 = 5 = 0101)
# ============================================================================
# A-1 is subtraction with a BORROW: bit0 is always flipped; the borrow propagates
# upward while the lower bits are 0. So bit_i flips exactly when ALL bits below i
# are 0.
borrow1(x) := aBit0(x)'                                # borrow reaches bit1 if bit0=0
borrow2(x) := aBit0(x)' & aBit1(x)'                    # ... bit2 if bit0,bit1 are both 0
borrow3(x) := aBit0(x)' & aBit1(x)' & aBit2(x)'        # ... bit3 if bit0..2 are all 0
decBit0(x) := aBit0(x)'                                # bit0 always flips
decBit1(x) := aBit1(x) ^ borrow1(x)
decBit2(x) := aBit2(x) ^ borrow2(x)
decBit3(x) := aBit3(x) ^ borrow3(x)

n decBit0(x)   # expect 1
n decBit1(x)   # expect 0
n decBit2(x)   # expect 1
n decBit3(x)   # expect 0

# ============================================================================
# WHAT WE LEARNED
# ============================================================================
# - A number is just a tuple of bit FUNCTIONS (aBit0..aBit3), not a bitvector.
# - Every arithmetic operation (addition, inc, dec) is a composition of
#   half / full adders.
# - Every comparison (==, >, <) is pure Boolean logic over the bits.
# - Tau normalizes each of these functions to 0 or 1 - provably correct,
#   entirely without arithmetic bitvector types.
# ============================================================================
# END OF BINARY ENCODING TUTORIAL
# ============================================================================
