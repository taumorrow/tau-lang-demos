# Title: Logic Gates
# Description: The four basic logic gates AND, OR, NOT, XOR over two inputs.
# All gates are computed in a single specification so the inputs are read once
# per step and feed every output.

# === INPUTS ===
i1 : sbf := in file("io/const1.in")   # input A
i2 : sbf := in file("io/const0.in")   # input B

# === OUTPUTS ===
o1 : sbf := out file("io/and.out")    # AND
o2 : sbf := out file("io/or.out")     # OR
o3 : sbf := out file("io/not.out")    # NOT A
o4 : sbf := out file("io/xor.out")    # XOR

# === ALL FOUR GATES, ONE SPEC ===
run always (
  (o1[t] = i1[t] & i2[t]) &&                          # AND
  (o2[t] = i1[t] | i2[t]) &&                          # OR
  (o3[t] = i1[t]') &&                                 # NOT (of the first input)
  (o4[t] = (i1[t] & i2[t]') | (i1[t]' & i2[t]))       # XOR (built from AND/OR/NOT; = i1 ^ i2)
)

# Example: A=1, B=0  ->  and=0, or=1, not=0, xor=1
